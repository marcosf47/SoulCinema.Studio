+<script id="rc201-live-public-renderer">
+(()=>{
+  const body=document.body;
+  const badge=document.getElementById('liveState');
+  const title=document.getElementById('liveTitle');
+  const subtitle=document.getElementById('liveSubtitle');
+  const publicBadge=document.getElementById('publicLiveBadge');
+  if(!body||!badge||!title||!subtitle)return;
+
+  const render=()=>{
+    const mode=body.dataset.liveMode||'standby';
+
+    if(publicBadge) publicBadge.setAttribute('aria-hidden', mode==='live'?'false':'true');
+
+    if(mode==='live'){
+      badge.textContent='● ON AIR · LIVE';
+      title.textContent='SOULCINEMA LIVE';
+      subtitle.textContent='You are watching a SoulCinema live experience.';
+      return;
+    }
+
+    if(mode==='ended'){
+      badge.textContent='SOULCINEMA · OFF AIR';
+      title.textContent='LIVE BROADCAST ENDED';
+      subtitle.textContent='Thank you for watching. Stay with SoulCinema for the next live experience.';
+      return;
+    }
+
+    if(mode==='countdown'){
+      badge.textContent='SOULCINEMA · STARTING SOON';
+      title.textContent='THE LIVE EXPERIENCE IS ABOUT TO BEGIN';
+      subtitle.textContent='Stay with SoulCinema.';
+      return;
+    }
+
+    if(mode==='replay'){
+      badge.textContent='SOULCINEMA · REPLAY';
+      title.textContent='SOULCINEMA REPLAY';
+      subtitle.textContent='Watch the latest SoulCinema live experience.';
+      return;
+    }
+
+    // standby / preparing / unknown
+    badge.textContent='SOULCINEMA · OFF AIR';
+    title.textContent='THE LIVE ROOM IS QUIET';
+    subtitle.textContent='The next SoulCinema live experience will begin here.';
+  };
+
+  new MutationObserver(render).observe(body,{
+    attributes:true,
+    attributeFilter:['data-live-mode']
+  });
+  window.addEventListener('load',render,{once:true});
+  render();
+})();
+</script>
